PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Leave empty to auto-generate a secret stored in data/secret.key
SESSION_SECRET=

# Users registering with this email become admins (can read /api/feedback)
ADMIN_EMAIL=

# Development only: return the password-reset token in the API response
# (otherwise it is only printed in the server console)
EXPOSE_RESET_TOKEN=true
